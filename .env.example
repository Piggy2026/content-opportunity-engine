# Content Opportunity Engine Environment Variables
PORT=3001
NODE_ENV=development

# Optional AI Engine Key (Google Gemini 2.5 / 1.5 with Google Search Grounding)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional YouTube Data API v3 Key (if provided, enables rich channel/video metrics)
